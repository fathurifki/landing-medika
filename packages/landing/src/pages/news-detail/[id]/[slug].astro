---
import Layouts from "@layouts/Layouts.astro";
import RemoteImage from "@components/RemoteImage.astro";
import { INTERNAL_API_URL, VITE_IMAGE_URL } from "@lib/env";
import { sanitizeHtml } from "@lib/sanitize";

const API_URL = INTERNAL_API_URL;
const IMAGE_URL = VITE_IMAGE_URL;

const { slug, id } = Astro.params;

async function getDetail() {
  try {
    const response = await fetch(`${API_URL}/items/Blog/${id}`);
    if (!response.ok) return null;
    const data = await response.json();
    return data;
  } catch { return null; }
}

const detail = await getDetail();
const blog = detail?.data;

const title = blog?.title ?? "News Detail";
const rawDesc = blog?.content ? blog.content.replace(/<[^>]*>/g, "").slice(0, 160) : "";
const description = rawDesc || "Read the latest news and updates from APM Medical Indonesia.";
const image = blog?.banner ?? null;

const structuredData = blog ? {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: title,
  description,
  image: image ? `${IMAGE_URL}/${image}` : undefined,
  datePublished: blog.dateCreated,
  dateModified: blog.updatedAt ?? blog.dateCreated,
  author: { "@type": "Organization", name: "PT Anugerah Prima Medika" },
  publisher: {
    "@type": "Organization",
    name: "APM Medical",
    logo: { "@type": "ImageObject", url: "https://apm-medical.co.id/APM.webp" },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `https://apm-medical.co.id/news-detail/${id}/${slug}` },
} : undefined;
---

<Layouts
  title={title}
  description={description}
  image={image ?? undefined}
  canonicalPath={`/news-detail/${id}/${slug}`}
  type="article"
  structuredData={structuredData}
>
  <main class="p-8">
    <article class="max-w-3xl mx-auto">
      <header class="mb-8">
        <h1 class="text-4xl font-bold mb-4">{blog?.title}</h1>
        <p class="text-gray-600">
          Published on: <time datetime={new Date(blog?.dateCreated).toISOString().split("T")[0]}>
            {new Date(blog?.dateCreated).toLocaleDateString("id-ID", { year: "numeric", month: "long", day: "numeric" })}
          </time>
        </p>
      </header>
      <section class="mb-8">
        {image && (
          <RemoteImage
            src={`${IMAGE_URL}/${image}`}
            alt={blog?.title}
            wrapperClass="w-full h-auto max-h-[500px] rounded-lg mb-4"
            width={800}
            height={450}
            loading="eager"
            fetchpriority="high"
            fit="cover"
          />
        )}
        <div class="text-lg leading-relaxed" set:html={sanitizeHtml(blog?.content)} />
      </section>

      {blog?.tags?.length > 0 && (
        <section class="mt-8">
          <h2 class="text-2xl font-bold mb-4">Tags</h2>
          <div class="flex flex-wrap gap-2">
            {blog.tags.map((tag: string) => (
              <span class="bg-blue-100 text-blue-800 text-sm font-medium px-2.5 py-0.5 rounded">
                {tag}
              </span>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</Layouts>
