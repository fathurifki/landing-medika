---
import RemoteImage from "@components/RemoteImage.astro";

export interface NewsCardProps {
    imgSrc: string;
    imgAlt: string;
    title: string;
    description: string;
    slugs: string;
}

const { imgSrc, imgAlt, title, description, slugs, id } = Astro.props;
---

<div>
    <a href={`/news-detail/${id}/${slugs}`}>
        <RemoteImage
            src={imgSrc}
            alt={imgAlt}
            width={250}
            height={250}
            loading="lazy"
            wrapperClass="w-full max-w-[250px] h-[250px] rounded-lg mb-4"
        />
        <h3 class="text-xl font-bold">
            {title}
        </h3>
        <div class="line-clamp-3" set:html={description} />
    </a>
</div>
